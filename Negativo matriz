#include <iostream>
using namespace std;

int main() {

    int M, N;
    cin >> M >> N;

    int mat[10][10];

    for (int i = 0; i < M; i++) {
        for (int j = 0; j < N; j++) {
            cin >> mat[i][j];
        }
    }

    for (int i = 0; i < M; i++) {
        for (int j = 0; j < N; j++) {
            if (mat[i][j] < 0) {
                cout << mat[i][j] << endl;
            }
        }
    }

    return 0;
}
