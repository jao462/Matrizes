#include <iostream>
using namespace std;

int main() {

    int N;
    cin >> N;

    int mat[10][10];

    for (int i = 0; i < N; i++) {
        for (int j = 0; j < N; j++) {
            cin >> mat[i][j];
        }
    }

    for (int i = 0; i < N; i++) {
        int maior = mat[i][0];
        for (int j = 1; j < N; j++) {
            if (mat[i][j] > maior) {
                maior = mat[i][j];
            }
        }
        cout << maior << endl;
    }

    return 0;
}
