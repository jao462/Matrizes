#include <iostream>
using namespace std;

int main() {

    int N;
    cout << "Qual a ordem da matriz? ";
    cin >> N;

    int mat[10][10]; // já deixo 10 como o máximo

    cout << "Digite os valores da matriz:\n";
    for (int i = 0; i < N; i++) {
        for (int j = 0; j < N; j++) {
            cin >> mat[i][j];
        }
    }

    cout << "DIAGONAL PRINCIPAL:\n";
    for (int i = 0; i < N; i++) {
        cout << mat[i][i] << " ";
    }
    cout << endl;

    int negativos = 0;
    for (int i = 0; i < N; i++) {
        for (int j = 0; j < N; j++) {
            if (mat[i][j] < 0) {
                negativos++;
            }
        }
    }

    cout << "QUANTIDADE DE NEGATIVOS = " << negativos << endl;

    return 0;
}
